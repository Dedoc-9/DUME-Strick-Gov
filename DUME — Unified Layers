// MARK: - GLOBAL SYSTEM WRAPPER (OPTIONAL ENTRY POINT)
// =====================================================

public final class DUME {

    public let engine: DUMEStrictEngine
    public let gov: DUMEGovEngine

    public init(storage: any DUMEPersistentStorage) {
        self.engine = DUMEStrictEngine(storage: storage)

        self.gov = DUMEGovEngine(
            engine: engine,
            policy: GovPolicy(maxDrift: 0.4, maxEntropy: 0.8)
        )
    }
}
