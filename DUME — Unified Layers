    public let ingestIndex: Int
    public let timestamp: UInt64
    public let checksum: String
}

// =====================================================
// MARK: - CLOCK (DETERMINISM FOUNDATION)
// =====================================================

public protocol DeterministicClock: Sendable {
    func tick() -> UInt64
    func now() -> UInt64
}

public final class MonotonicClock: DeterministicClock {
    private var counter: UInt64 = 0
    private let lock = NSLock()

    public init() {}

    public func tick() -> UInt64 {
        lock.lock(); defer { lock.unlock() }
        counter += 1
        return counter
    }

    public func now() -> UInt64 { counter }
}

// =====================================================
// MARK: - STORAGE LAYER
// =====================================================

public protocol DUMEPersistentStorage: Sendable {
    func put(_ envelope: DeterministicEnvelope) async throws
    func get(_ id: String) async throws -> DeterministicEnvelope?
}

// In-memory reference implementation
public actor MemoryStorage: DUMEPersistentStorage {
    private var store: [String: DeterministicEnvelope] = [:]

    public init() {}

    public func put(_ envelope: DeterministicEnvelope) async throws {
        store[envelope.anchor.id] = envelope
    }

    public func get(_ id: String) async throws -> DeterministicEnvelope? {
        store[id]
    }
}

