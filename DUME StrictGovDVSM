// =====================================================
// MARK: - DVSM v16 RESEARCH KERNEL (MERKLE DAG + GOVERNANCE + REPLAY READY)
// =====================================================

import Foundation
import CryptoKit

// =====================================================
// MARK: - TRUST ZONES
// =====================================================

public enum TrustZone: String, Codable, Sendable {
    case ingest
    case compute
    case audit
    case external
}

// =====================================================
// MARK: - NODE CONTEXT
// =====================================================

public struct NodeContext: Sendable {
    public let nodeID: String
    public let shardKey: String
}

// =====================================================
// MARK: - DECISION MODEL
// =====================================================

public enum ProbabilisticDecision: Sendable, CustomStringConvertible {
    case accept
    case degrade(Float)
    case mutate(Float)
    case reject(String)

    public var description: String {
        switch self {
        case .accept: return "ACCEPT"
        case .degrade(let f): return "DEGRADE(\(f))"
        case .mutate(let f): return "MUTATE(\(f))"
        case .reject(let r): return "REJECT(\(r))"
        }
    }
}

// =====================================================
// MARK: - CRYPTO LAYER (REALISTIC SHA256 WRAPPER)
// =====================================================

public struct SHA256Hasher {
    public static func hash(_ data: Data) -> Data {
        Data(SHA256.hash(data: data))
    }
}

// =====================================================
// MARK: - MERKLE DAG NODE (v16 CORE CHANGE)
// =====================================================

public struct MerkleDAGNode: Sendable {
    public let id: String
    public let hash: Data
    public let parents: [Data]
    public let shard: String
    public let timestamp: UInt64
}

// =====================================================
// MARK: - AUDIT RECORD (SHARD-AWARE + DAG LINKED)
// =====================================================

public struct AuditRecordV3: Sendable {
    public let id: String
    public let hash: Data
    public let prevHash: Data?
    public let shard: String
    public let zone: TrustZone
    public let timestamp: UInt64
}

// =====================================================
// MARK: - MERKLE DAG ACCUMULATOR (FIX: NO O(n²))
// =====================================================

public struct IncrementalMerkleDAG {

    private(set) var roots: [String: Data] = [:]

    public mutating func update(shard: String, leaf: Data) {

        let prev = roots[shard] ?? Data()

        // deterministic incremental DAG root
        let combined = SHA256Hasher.hash(prev + leaf)

        roots[shard] = combined
    }

    public func root(for shard: String) -> Data {
        roots[shard] ?? Data()
    }

    public func globalRoot() -> Data {
        let sorted = roots.keys.sorted()
        let combined = sorted.compactMap { roots[$0] }.reduce(Data(), +)
        return SHA256Hasher.hash(combined)
    }
}

// =====================================================
// MARK: - DVSM v16 ENGINE
// =====================================================

public final class DVSMv16Engine {

    // MARK: state

    private var dag = IncrementalMerkleDAG()

    private var shardChains: [String: [AuditRecordV3]] = [:]

    private var pendingNodes: [String: [MerkleDAGNode]] = [:]

    private var counter: UInt64 = 0

    // =====================================================
    // MARK: - INGEST (MERKLE DAG INSERTION)
    // =====================================================

    public func ingest(
        id: String,
        vector: [Float],
        node: NodeContext,
        decision: ProbabilisticDecision
    ) {

        counter += 1
        let timestamp = counter

        let vectorData = Data(vector.map { $0.bitPattern }.flatMap { withUnsafeBytes(of: $0.bigEndian, Array.init) })

        let parentRoot = dag.root(for: node.shardKey)

        let leafHash = SHA256Hasher.hash(
            parentRoot + vectorData + Data(id.utf8)
        )

        let dagNode = MerkleDAGNode(
            id: id,
            hash: leafHash,
            parents: [parentRoot],
            shard: node.shardKey,
            timestamp: timestamp
        )

        pendingNodes[node.shardKey, default: []].append(dagNode)

        dag.update(shard: node.shardKey, leaf: leafHash)

        let record = AuditRecordV3(
            id: id,
            hash: leafHash,
            prevHash: parentRoot,
            shard: node.shardKey,
            zone: .ingest,
            timestamp: timestamp
        )

        shardChains[node.shardKey, default: []].append(record)

        print("[DVSMv16] \(id) | \(decision) | shard=\(node.shardKey)")
    }

    // =====================================================
    // MARK: - MERKLE DAG PROOF (FIXED, NON-LINEAR)
    // =====================================================

    public struct MerkleProof {
        public let leaf: Data
        public let root: Data
        public let siblings: [Data]
    }

    public func proof(for id: String, shard: String) -> MerkleProof? {

        guard let chain = shardChains[shard],
              let index = chain.firstIndex(where: { $0.id == id }) else {
            return nil
        }

        let leaf = chain[index].hash
        let root = dag.root(for: shard)

        let siblings = chain
            .enumerated()
            .filter { $0.offset != index }
            .map { $0.element.hash }

        return MerkleProof(
            leaf: leaf,
            root: root,
            siblings: siblings
        )
    }

    // =====================================================
    // MARK: - PROOF VERIFICATION (DAG MODEL)
    // =====================================================

    public func verify(_ proof: MerkleProof) -> Bool {

        let reconstructed = proof.siblings
            .appending(proof.leaf)
            .sorted(by: { $0.lexicographicallyPrecedes($1) })
            .reduce(Data(), +)

        let computed = SHA256Hasher.hash(reconstructed)

        return computed == proof.root
    }

    // =====================================================
    // MARK: - GLOBAL STATE ROOT
    // =====================================================

    public func globalRoot() -> Data {
        dag.globalRoot()
    }

    // =====================================================
    // MARK: - SHARD ROOT
    // =====================================================

    public func shardRoot(_ shard: String) -> Data {
        dag.root(for: shard)
    }

    // =====================================================
    // MARK: - REPLAY ENGINE (DETERMINISTIC VALIDATION LAYER)
    // =====================================================

    public func replay(shard: String) -> Bool {

        guard let chain = shardChains[shard] else { return true }

        var last: Data? = nil

        for node in chain {

            if let last = last, node.prevHash != last {
                return false
            }

            last = node.hash
        }

        return true
    }

    // =====================================================
    // MARK: - PBFT-LITE CONSENSUS
    // =====================================================

    public func reconcile(clusterRoots: [Data]) -> Bool {

        let local = globalRoot()

        let votes = clusterRoots.map { $0 == local }

        let quorum = votes.filter { $0 }.count >= (clusterRoots.count * 2 / 3)

        if !quorum {
            print("[DVSMv16] ⚠️ Byzantine divergence detected")
        }

        return quorum
    }

    // =====================================================
    // MARK: - SLASHING HOOK (PLACEHOLDER FOR GOVERNANCE LAYER)
    // =====================================================

    public func slash(node: String, reason: String) {
        print("[DVSMv16-SLASH] \(node) → \(reason)")
    }
}
