// =====================================================
// MARK: - AUDIT LOG (MERKLE DAG + NIZK + VRF READY)
// =====================================================

public struct AuditRecord: Sendable {
    public let id: String
    public let hash: Data
    public let prevHash: Data?
    public let vrf: Float
    public let proof: NIZKProof?
}

public actor AuditLog {
    private var records: [AuditRecord] = []
    private let crypto: GovCrypto
    private var seed: UInt64 = 0xA1B2C3D4

    public init(crypto: GovCrypto) {
        self.crypto = crypto
    }

    public func append(
        id: String,
        envelope: DeterministicEnvelope,
        decision: String
    ) throws {

        let encoded = try JSONEncoder().encode(envelope)
        let hash = crypto.hash(encoded)
        let prev = records.last?.hash

        let vrf = VRF.eval(seed: seed, context: id)

        let proof: NIZKProof? = (decision == "REJECT")
            ? NIZKProof(
                statementHash: id,
                decision: decision,
                commitment: hash.base64EncodedString()
            )
            : nil

        records.append(
            AuditRecord(
                id: id,
                hash: hash,
                prevHash: prev,
                vrf: vrf,
                proof: proof
            )
        )
    }

    public func verify() -> Bool {
        var prev: Data?

        for r in records {
            if let p = prev, r.prevHash != p {
                return false
            }
            prev = r.hash
        }

        return true
    }
}

// =====================================================
// MARK: - STRICT ENGINE (CORE DVSM EXECUTION)
// =====================================================

public final class DUMEStrictEngine {

    private let storage: any DUMEPersistentStorage
    private let clock: DeterministicClock
    private let compression: SparseCompression
    private let index = ApproximateIndex()
    private let graph = GraphEvolution()
    private let gossip = StrictGossip()
    private let burst = BurstDetector()

    public init(
        storage: any DUMEPersistentStorage,
        clock: DeterministicClock = MonotonicClock(),
        compression: SparseCompression = .init()
    ) {
        self.storage = storage
        self.clock = clock
        self.compression = compression
    }

    public func retrieveEnvelope(id: String) async throws -> DeterministicEnvelope? {
        try await storage.get(id)
    }

    public func ingest(
        id: String,
        vector: [Float],
        ctx: CompressionContext
    ) async throws {

        let version = clock.tick()

        let (values, indices) = try compression.compress(
            vector,
            entropy: ctx.entropy,
            drift: ctx.drift
        )

        let anchor = Anchor(
            id: id,
            values: values,
            indices: indices,
            version: Int(version),
            timestamp: version,
            originalSize: vector.count
        )

        let envelope = DeterministicEnvelope(
            anchor: anchor,
            entropy: ctx.entropy,
            drift: ctx.drift,
            phase: .active,
            ingestIndex: Int(version),
            timestamp: version,
            checksum: "\(id)-\(version)"
        )

        try await storage.put(envelope)

        index.insert(id: id, vector: vector)
        graph.update(id: id, vector: vector)

        await gossip.append(OrderedDelta(id: id, vector: vector, version: version))
    }
}

// =====================================================
// MARK: - GOVERNANCE ENGINE
// =====================================================

public final class DUMEGovEngine {

    private let engine: DUMEStrictEngine
    private let audit: AuditLog
    private let policy: GovPolicy

    public init(
        engine: DUMEStrictEngine,
        policy: GovPolicy,
        crypto: GovCrypto = SHA256Crypto()
    ) {
        self.engine = engine
        self.policy = policy
        self.audit = AuditLog(crypto: crypto)
    }

    private func enforce(_ ctx: CompressionContext) throws {
        guard ctx.drift <= policy.maxDrift else {
            throw DUMEError.invalidVector("Drift violation")
        }

        guard ctx.entropy <= policy.maxEntropy else {
            throw DUMEError.invalidVector("Entropy violation")
        }
    }

    public func ingest(
        id: String,
        vector: [Float],
        ctx: CompressionContext
    ) async throws {

        try enforce(ctx)

        try await engine.ingest(id: id, vector: vector, ctx: ctx)

        guard let env = try await engine.retrieveEnvelope(id: id) else {
            throw DUMEError.storageError("Missing envelope")
        }

        try audit.append(id: id, envelope: env, decision: "ACCEPT")
    }

    public func verify() -> Bool {
        audit.verify()
    }
}

// =====================================================
// MARK: - SYSTEM ENTRY
// =====================================================

public final class DUME {

    public let engine: DUMEStrictEngine
    public let gov: DUMEGovEngine

    public init(storage: any DUMEPersistentStorage) {
        self.engine = DUMEStrictEngine(storage: storage)

        self.gov = DUMEGovEngine(
            engine: engine,
            policy: GovPolicy(maxDrift: 0.4, maxEntropy: 0.8)
        )
    }
}
