// =====================================================
// MARK: - STORAGE LAYER
// =====================================================

public protocol DUMEPersistentStorage: Sendable {
    func put(_ envelope: DeterministicEnvelope) async throws
    func get(_ id: String) async throws -> DeterministicEnvelope?
}

// In-memory reference implementation
public actor MemoryStorage: DUMEPersistentStorage {
    private var store: [String: DeterministicEnvelope] = [:]

    public init() {}

    public func put(_ envelope: DeterministicEnvelope) async throws {
        store[envelope.anchor.id] = envelope
    }

    public func get(_ id: String) async throws -> DeterministicEnvelope? {
        store[id]
    }
}

