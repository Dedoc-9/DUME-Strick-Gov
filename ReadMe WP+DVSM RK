// =====================================================
// MARK: - MERKLE ACCUMULATOR (INCREMENTAL O(1))
// =====================================================

public final class MerkleAccumulator {

    private var tips: [String: String] = [:]

    public init() {}

    public func update(shard: String, hash: String) {
        tips[shard] = hash
    }

    public func root() -> String {
        let combined = tips.values.sorted().joined(separator: "|")
        return CryptoHasher.hash(Data(combined.utf8))
    }

    public func shardRoot(_ shard: String) -> String {
        tips[shard] ?? "GENESIS"
    }
}

// =====================================================
// MARK: - PBFT LITE CONSENSUS
// =====================================================

public struct PBFTLite {

    public func quorum(_ votes: [Bool]) -> Bool {
        guard !votes.isEmpty else { return false }
        let yes = votes.filter { $0 }.count
        return yes >= (votes.count * 2 / 3)
    }
}

// =====================================================
// MARK: - DVSM CORE ENGINE
// =====================================================

public final class DVSMv16Engine {

    private let zk: ZKVerifier
    private let pbft = PBFTLite()

    private let accumulator = MerkleAccumulator()

    private var shardChains: [String: [AuditRecord]] = [:]
    private var seed: UInt64 = 0xA1B2C3D4
    private var counter: UInt64 = 0

    public init(zk: ZKVerifier = RustZKBridge()) {
        self.zk = zk
    }

    // =====================================================
    // MARK: - INGEST PIPELINE
    // =====================================================

    public func ingest(
        id: String,
        vector: [Float],
        instability: Float,
        confidence: Float,
        node: String,
        shard: String
    ) {

        counter += 1

        let vrf = VRF.eval(seed: seed, context: id)
        let trace = "ID:\(id)|NODE:\(node)|T:\(counter)"

        let prev = accumulator.shardRoot(shard)

        let payload = Data((prev + trace).utf8)
        let hash = CryptoHasher.hash(payload)

        // =================================================
        // ZK STATEMENT (POLICY + TRACE)
        // =================================================

        let policyHash = Data("policy_v16".utf8)
        let zkValid = zk.verify(policyHash: policyHash,
                                trace: Data(trace.utf8),
                                proof: Data([vrf]))

        let zkProof = NIZKProof(
            statement: id,
            commitment: hash,
            proof: Data([vrf])
        )

        let record = AuditRecord(
            id: id,
            trace: trace,
            hash: hash,
            prevHash: prev,
            zkProof: zkValid ? zkProof : nil
        )

        shardChains[shard, default: []].append(record)
        accumulator.update(shard: shard, hash: hash)

        print("[DVSMv16] \(trace) | ZK:\(zkValid)")
    }

    // =====================================================
    // MARK: - MERKLE ROOT (GLOBAL DAG STATE)
    // =====================================================

    public func globalRoot() -> String {
        accumulator.root()
    }

    public func shardRoot(_ shard: String) -> String {
        accumulator.shardRoot(shard)
    }

    // =====================================================
    // MARK: - RECONCILIATION (PBFT LITE)
    // =====================================================

    public func reconcile(votes: [String: String]) -> Bool {

        let local = globalRoot()
        let results = votes.values.map { $0 == local }

        let ok = pbft.quorum(results)

        if !ok {
            print("[DVSMv16] ⚠️ BYZANTINE QUORUM FAILURE")
        }

        return ok
    }

    // =====================================================
    // MARK: - DAG PROOF (SIMPLIFIED)
    // =====================================================

    public func merkleProof(shard: String, id: String) -> (leaf: String, root: String, path: [String])? {

        guard let chain = shardChains[shard],
              let index = chain.firstIndex(where: { $0.id == id }) else {
            return nil
        }

        let leaf = chain[index].hash
        let root = accumulator.shardRoot(shard)

        let path = chain.prefix(index).map { $0.hash }

        return (leaf, root, Array(path))
    }
}

// =====================================================
// MARK: - PROOF VERIFIER EXTENSION
// =====================================================

extension DVSMv16Engine {

    public func verifyProof(
        leaf: String,
        root: String,
        path: [String]
    ) -> Bool {

        var current = leaf

        for p in path {
            current = CryptoHasher.hash(Data((p + current).utf8))
        }

        return current == root
    }
}
